# --- Rust / Cargo ---
/target
**/*.rs.bk
Cargo.lock.bak

# --- IDA SDK (must NEVER be committed: Hex-Rays license forbids redistribution.
# For CI, store an encrypted archive + password in GitHub Secrets.) ---
/idasdk*/
idasdk*.zip

# --- Runtime state (sessions registry, config, temp IDBs) ---
# Created wherever IDALIB_CLI_HOME points; default is ~/.idapro/idalib-cli
/.idapro/
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til

# --- IDA generated files ---
*.asm
*.lst
*.map

# --- IDE / editors ---
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Environment / secrets ---
.env
.env.*
*.local

# --- Coverage / profiling ---
*.profraw
*.profdata
